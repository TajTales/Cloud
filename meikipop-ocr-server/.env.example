# CT-03 DRAFT — safe OCR adapter/test template; not auto-loaded by this Python app.
# Export variables explicitly in the shell when needed.
# No dotenv loader or Compose env_file is configured in the current code.

# Read by the owocr provider only. Requires an external owocr service.
OWOCR_WEBSOCKET_URI=ws://127.0.0.1:7331

# Read by test_server.py only, not OCR server startup configuration.
OCR_SERVER_URL=http://localhost:8080
OCR_WS_URL=ws://localhost:8080/ws

# Server startup uses CLI --provider / --host / --port / --workers.
# Current default provider is glensv2; adding OCR_PROVIDER here does not change it.
# For isolated transport testing choose --provider dummy explicitly.
# Do not put model/provider credentials, application tokens or AWS keys here.
