# Reference only. This service reads exported environment variables, not dotenv files.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8081
DATA_MODE=real
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
APP_MAX_BODY_BYTES=1048576
LOG_LEVEL=INFO
# Group 2 storage is opt-in. Start scripts/dev-db and run scripts/db-admin init first.
PERSISTENCE_ENABLED=0
# Explicit local password auth + 11 learning handlers; requires PERSISTENCE_ENABLED=1.
# Group 3: mailbox files, access/refresh, verified Admin + account management.
# No SMTP/AWS calls; see docs/GROUP-03-AUTH-AND-AUTHORIZATION.md.
# scripts/dev-local-api enables both. This is not Cognito or a production auth mode.
LOCAL_AUTH_ENABLED=0
# Group 4/5: scripts/dev-local-api enables OCR and starts a durable polling worker.
# Start scripts/dev-ocr (ja) and scripts/dev-ocr-zh (zh) in separate terminals.
OCR_ENABLED=0
OCR_SERVICE_URL=http://127.0.0.1:8080
# Optional outside dev-local-api; omitting this disables Chinese OCR capability.
OCR_CHINESE_SERVICE_URL=http://127.0.0.1:8083
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_TABLE=lingualive-local
# APP_DATA_DIR=/absolute/path/to/private/local-data
# Optional: absolute path to this checkout's contracts directory.
# CONTRACTS_DIR=/absolute/path/to/checkout/contracts
# No AWS/Docker/database/credentials are needed for foundation startup.
# With LOCAL_AUTH_ENABLED=0 authentication remains unconfigured and fails closed.
