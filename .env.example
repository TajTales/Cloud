# CT-03 DRAFT — safe frontend template, not active configuration.
# Source: vite.config.ts reads these from the SHELL process environment.
# Copying PORT into .env.local does NOT set server.port in the current config.
# Use a shell prefix such as PORT=8443 pnpm dev when starting a new dev server.
# Figma Make already runs the preview server; do not start a second one.
PORT=8443
FIGMA_DEV_SERVER_HOST=0.0.0.0

# PROPOSED ONLY — no consumers/proxy/auth adapter exist for these yet.
# Uncomment only in a future integration task after the contract is reviewed.
# VITE_API_BASE_URL=/api/v1
# VITE_REALTIME_URL=ws://localhost:8081/realtime
# VITE_DATA_MODE=mock
# VITE_COGNITO_REGION=
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_CLIENT_ID=
# VITE_* values are public browser configuration; never store secrets here.
# Real WS uses the authenticated ticket response ws_url, not a hardcoded raw /ws.
